# Senha do painel administrativo (obrigatória em produção; sem ela uma senha aleatória é gerada a cada início).
# Só pode ser definida aqui (ou no Secret Manager): o painel não permite alterá-la. O acesso exige também o código 2FA.
ADMIN_PASSWORD=

# Domínios de e-mail aceitos nas inscrições (separados por vírgula; vazio = sem restrição)
ALLOWED_EMAIL_DOMAINS="tjpr.jus.br"

# Limites anti-spam (opcionais)
# SIGNUP_MAX_PER_IP=30
# SIGNUP_MAX_ERRORS_PER_IP=120
# SIGNUP_MAX_GLOBAL_PER_HOUR=600
